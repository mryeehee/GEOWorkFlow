{
    "id": "geoflow-template-21-enterprise-signature",
    "colors": {
        "page": "#ffffff",
        "surface": "#ffffff",
        "ink": "#0a0b0d",
        "muted": "#626a75",
        "line": "#dfe3e8",
        "line_strong": "#b8c0ca",
        "blue": "#0b57d0",
        "blue_dark": "#073b8c",
        "success": "#087f5b",
        "danger": "#b42318"
    },
    "typography": {
        "display": "\"Avenir Next\", \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", sans-serif",
        "body": "\"Inter\", \"SF Pro Text\", \"Segoe UI\", \"PingFang SC\", sans-serif",
        "editorial": "\"Iowan Old Style\", \"Songti SC\", \"Noto Serif SC\", serif",
        "base_size": "16px",
        "line_height": "1.7"
    },
    "layout": {
        "shell_width": "1280px",
        "content_width": "760px",
        "section_space": "clamp(88px, 10vw, 148px)",
        "page_background": "solid white",
        "section_background": "solid white",
        "card_radius": "18px",
        "button_radius": "8px"
    },
    "depth": {
        "card_shadow": "0 18px 50px rgba(10, 11, 13, 0.08)",
        "hero_shadow": "0 32px 90px rgba(10, 11, 13, 0.14)",
        "strategy": "borders, spacing, solid color, and physical shadows"
    },
    "motion": {
        "properties": [
            "opacity",
            "transform"
        ],
        "reduced_motion": true
    }
}
